{
  "name": "hiresync",
  "version": "1.0.0",
  "description": "Tech Internship Aggregator Pipeline - scrapes startup job boards, de-duplicates postings in PostgreSQL, and serves them over a REST API.",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "scrape": "node src/scripts/runOnce.js",
    "test": "node --test tests/",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "scraper",
    "express",
    "prisma",
    "postgresql",
    "cheerio",
    "node-cron"
  ],
  "author": "Abdulkalam0018",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
