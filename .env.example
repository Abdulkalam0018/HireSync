# ------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.  (cp .env.example .env)
# .env is git-ignored so secrets never reach GitHub.
# ------------------------------------------------------------------

# --- Database --------------------------------------------------------
# Neon / Supabase give you this string in their dashboard.
# Keep `?sslmode=require` for cloud providers.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hiresync?sslmode=require"

# --- HTTP server -----------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Scraper ---------------------------------------------------------
# The first page of the job board to scrape. By default we point at the
# built-in mock board (served by this same app) so the pipeline works offline.
SCRAPE_BASE_URL="http://localhost:3000/mock-board/jobs"
# Logical name of the source. Used to namespace externalJobId (e.g. "mockyc:1001")
SCRAPE_SOURCE_NAME="mockyc"
# Safety cap so a pagination bug can never loop forever.
SCRAPE_MAX_PAGES=10
# Random politeness delay between page requests (milliseconds).
SCRAPE_MIN_DELAY_MS=1500
SCRAPE_MAX_DELAY_MS=4000
# Network resilience
SCRAPE_TIMEOUT_MS=10000
SCRAPE_MAX_RETRIES=3

# --- Scheduler -------------------------------------------------------
# "At minute 0 past every 12th hour" -> 00:00 and 12:00.
CRON_SCHEDULE="0 */12 * * *"
CRON_TIMEZONE="Asia/Kolkata"
CRON_ENABLED=true

# --- Security --------------------------------------------------------
# If set, POST /api/scrape/trigger requires header `x-api-key: <value>`.
SCRAPE_API_KEY="change-me"

# --- Mock job board (development/demo only) -------------------------
ENABLE_MOCK_BOARD=true
# Probability (0..1) that the mock board returns HTTP 503 - use it to demo retries.
MOCK_FAIL_RATE=0
